# OpenShelf Environment Configuration
# Copy this file to .env and customize for your deployment

# Backend Configuration
# Required. Generate a strong random value, e.g.: openssl rand -base64 48
JWT_SECRET=

# Frontend Configuration
# Leave empty for dynamic detection (localhost, LAN IP)
# Set for production behind reverse proxy (e.g., https://books.stelling19.nl)
VITE_API_URL=
